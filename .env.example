# Set these as environment secrets (Claude Code on the web: environment settings),
# or export them in your shell before running `claude`. Never commit real values.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Optional: manager (MCC) account ID, digits only, no hyphens
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional: tool groups to load (default: all). e.g. core,reporting
GOOGLE_ADS_MCP_GROUPS=all
